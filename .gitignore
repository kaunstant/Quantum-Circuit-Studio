# CMake and compiler output
/build/
/cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
*.ilk
*.pdb
*.idb
*.obj
*.o
*.tlog/

# Generated model and application output
/outputs/

# Python virtual environments, bytecode, and local caches
/.venv/
**/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Locally bootstrapped CMake distributions
/tools/cmake-*/
/enginetools/cmake-*/

# OS and IDE user state
.DS_Store
Thumbs.db
.vs/

# Intentionally do not ignore .tools/Qt: the local Qt distribution is required
# by the build and should remain available to Git.
!/.tools/Qt/
!/.tools/Qt/**
